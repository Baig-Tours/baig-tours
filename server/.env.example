# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/baig-tours
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/baig-tours
MONGO_URI=mongodb://127.0.0.1:27017/baig-tours

# ── Auth / JWT ───────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# ── Frontend origin (for CORS) ───────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Seed admin (used only by utils/seedAdmin.js) ─────────────
SEED_ADMIN_NAME=Ahsan Baig
SEED_ADMIN_EMAIL=admin@baigtours.com
SEED_ADMIN_PASSWORD=change_this_password
